PORT=3001
MONGODB_URI=mongodb+srv://PORTFOLIO_APP_USER:REPLACE_WITH_PASSWORD@YOUR_CLUSTER_HOST/portfolio?retryWrites=true&w=majority
MONGODB_DB=portfolio
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_TTL_MINUTES=60
# Comma-separated browser origins allowed to call this API with session cookies.
FRONTEND_ORIGINS=http://localhost:5173,https://www.sudiptoroy.com,https://sudiptoroy.com
SITE_ORIGIN=https://www.sudiptoroy.com
# Vercel project deploy hook used after authenticated publishing actions.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/REPLACE_ME

# Cloudflare R2 (server-only; never use these in a VITE_ variable)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_API_TOKEN=replace-with-cloudflare-api-token
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
# Use the jurisdiction-specific S3 endpoint Cloudflare provides, without a bucket suffix.
R2_ENDPOINT=https://ACCOUNT_ID.JURISDICTION.r2.cloudflarestorage.com
